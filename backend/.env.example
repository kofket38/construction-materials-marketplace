# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cmm
# DIRECT_URL is required in production (Render) when DATABASE_URL points to
# a Supabase session pooler (port 6543). prisma migrate deploy requires a
# direct PostgreSQL connection that supports DDL. Set this to the Supabase
# direct connection URL (port 5432). Leave unset in local development.
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
PORT=3000
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters and DIFFERENT from each other.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Payment-proof storage (LOCAL DEVELOPMENT) ─────────────────────────────────
# Used when SUPABASE_URL is not set. In production on Render, use Supabase Storage.
PAYMENT_PROOF_UPLOAD_DIR=uploads/payment-proofs

# ── Supabase Storage (PRODUCTION / RENDER) ────────────────────────────────────
# When all three are present, Supabase Storage is used instead of the local
# filesystem. The service-role key grants full bucket access — NEVER expose it
# to the frontend or put it in any VITE_* variable.
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>    ← BACKEND ONLY — never VITE_*
# SUPABASE_STORAGE_BUCKET=payment-proofs
