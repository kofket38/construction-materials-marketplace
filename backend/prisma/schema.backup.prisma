generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RfqStatus {
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum SupplierQuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CLOSED
}

enum RfqUnit {
  BAG
  KG
  TONNE
  LITRE
  METRE
  SQUARE_METRE
  CUBIC_METRE
  PIECE
  ROLL
  PALLET
  LOAD
  OTHER
}

model User {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  firstName      String?
  lastName       String?
  email          String            @unique
  passwordHash   String
  phone          String?
  company        String?
  role           Role              @default(CUSTOMER)
  isActive       Boolean           @default(true)
  emailVerified  Boolean           @default(false)
  refreshToken   String?
  sellerProfile  SellerProfile?
  listedProducts Product[]         @relation("SellerProducts")
  orders         Order[]           @relation("CustomerOrders")
  reviews        Review[]          @relation("CustomerReviews")
  wishlistItems  WishlistItem[]    @relation("CustomerWishlist")
  rfqs           RequestForQuote[] @relation("CustomerRfqs")
  supplierQuotes SupplierQuote[]   @relation("SellerQuotes")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model SellerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  shopName  String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopName])
  @@index([shopName(ops: raw("gin_trgm_ops"))], type: Gin, map: "seller_profiles_shopName_trgm_idx")
  @@map("seller_profiles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  products    Product[]
  rfqItems    RfqItem[]

  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  sellerId           String              @db.Uuid
  categoryId         String              @db.Uuid
  name               String
  description        String
  price              Decimal             @db.Decimal(12, 2)
  quantity           Int                 @default(0)
  imageUrl           String?
  seller             User                @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  orderItems         OrderItem[]
  reviews            Review[]
  wishlistItems      WishlistItem[]      @relation("ProductWishlist")
  preferredRfqItems  RfqItem[]           @relation("PreferredRfqProduct")
  supplierQuoteItems SupplierQuoteItem[] @relation("QuotedProduct")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([sellerId, categoryId])
  @@index([name])
  @@index([price])
  @@index([quantity])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_images")
}

model Order {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @db.Uuid
  status      OrderStatus    @default(PENDING)
  totalAmount Decimal        @db.Decimal(14, 2)
  customer    User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  sourceQuote SupplierQuote?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([productId, createdAt])
  @@index([customerId])
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  customer   User     @relation("CustomerWishlist", fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation("ProductWishlist", fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

model RequestForQuote {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @db.Uuid
  title            String
  deliveryLocation String
  notes            String?
  status           RfqStatus       @default(OPEN)
  expiresAt        DateTime
  awardedQuoteId   String?         @unique @db.Uuid
  customer         User            @relation("CustomerRfqs", fields: [customerId], references: [id], onDelete: Restrict)
  items            RfqItem[]
  quotes           SupplierQuote[] @relation("RfqQuotes")
  awardedQuote     SupplierQuote?  @relation("AwardedRfqQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("request_for_quotes")
}

model RfqItem {
  id                 String              @id @default(uuid()) @db.Uuid
  rfqId              String              @db.Uuid
  categoryId         String?             @db.Uuid
  preferredProductId String?             @db.Uuid
  categoryName       String
  materialName       String
  specifications     String?
  requestedQuantity  Decimal             @db.Decimal(14, 3)
  requestedUnit      RfqUnit
  customUnit         String?
  rfq                RequestForQuote     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  preferredProduct   Product?            @relation("PreferredRfqProduct", fields: [preferredProductId], references: [id], onDelete: SetNull)
  quoteItems         SupplierQuoteItem[]
  createdAt          DateTime            @default(now())

  @@index([rfqId])
  @@index([categoryId])
  @@index([preferredProductId])
  @@map("rfq_items")
}

model SupplierQuote {
  id           String              @id @default(uuid()) @db.Uuid
  rfqId        String              @db.Uuid
  sellerId     String              @db.Uuid
  status       SupplierQuoteStatus @default(SUBMITTED)
  validUntil   DateTime
  leadTimeDays Int
  terms        String?
  totalAmount  Decimal             @db.Decimal(14, 2)
  orderId      String?             @unique @db.Uuid
  rfq          RequestForQuote     @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  seller       User                @relation("SellerQuotes", fields: [sellerId], references: [id], onDelete: Restrict)
  items        SupplierQuoteItem[]
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  awardedFor   RequestForQuote?    @relation("AwardedRfqQuote")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([rfqId, sellerId])
  @@index([rfqId, status])
  @@index([sellerId, createdAt])
  @@index([sellerId, status])
  @@index([validUntil])
  @@map("supplier_quotes")
}

model SupplierQuoteItem {
  id              String        @id @default(uuid()) @db.Uuid
  quoteId         String        @db.Uuid
  rfqItemId       String        @db.Uuid
  productId       String?       @db.Uuid
  productName     String
  offeredQuantity Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)
  quote           SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem         RfqItem       @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)
  product         Product?      @relation("QuotedProduct", fields: [productId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@unique([quoteId, rfqItemId])
  @@unique([quoteId, productId])
  @@index([rfqItemId])
  @@index([productId])
  @@map("supplier_quote_items")
}
