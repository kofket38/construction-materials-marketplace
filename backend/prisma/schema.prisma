generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_PAYMENT_VERIFICATION
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PENDING_CONFIRMATION
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  REJECTED
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  TELEBIRR
  CBE_BIRR
  AWASH_BIRR
  BANK_TRANSFER
  CBE_BANK
  AWASH_BANK
  DASHEN_BANK
  E_BIRR
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum RfqStatus {
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum SupplierQuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CLOSED
}

enum RfqUnit {
  BAG
  KG
  TONNE
  LITRE
  METRE
  SQUARE_METRE
  CUBIC_METRE
  PIECE
  ROLL
  PALLET
  LOAD
  OTHER
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductImageType {
  OFFICIAL
  DEFAULT
  SELLER_UPLOAD
}

enum InventoryTransactionType {
  ORDER_SHIPMENT
  ORDER_CANCELLATION
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  firstName         String?
  lastName          String?
  email             String            @unique
  passwordHash      String
  phone             String?
  company           String?
  role              Role              @default(CUSTOMER)
  isActive          Boolean           @default(true)
  emailVerified     Boolean           @default(false)
  refreshToken      String?
  sellerProfile     SellerProfile?
  listedProducts    Product[]         @relation("SellerProducts")
  createdProducts   Product[]         @relation("SellerCreatedProducts")
  orders            Order[]           @relation("CustomerOrders")
  reviews           Review[]          @relation("CustomerReviews")
  wishlistItems     WishlistItem[]    @relation("CustomerWishlist")
  rfqs              RequestForQuote[] @relation("CustomerRfqs")
  supplierQuotes    SupplierQuote[]   @relation("SellerQuotes")
  sellerInventories SellerInventory[] @relation("SellerInventory")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model SellerProfile {
  id                         String   @id @default(uuid()) @db.Uuid
  userId                     String   @unique @db.Uuid
  shopName                   String
  phone                      String
  address                    String
  paymentAccountName         String?
  telebirrNumber             String?
  cbeBirrNumber              String?
  cbeBankAccountNumber       String?
  awashBankAccountNumber     String?
  dashenBankAccountNumber    String?
  eBirrNumber                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopName])
  @@index([shopName(ops: raw("gin_trgm_ops"))], type: Gin, map: "seller_profiles_shopName_trgm_idx")
  @@map("seller_profiles")
}

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  imageUrl    String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  products    Product[]
  rfqItems    RfqItem[]

  @@map("categories")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  // Temporary seller ownership (keep for existing data migration)
  sellerId String @db.Uuid

  // Catalog relationships
  categoryId String  @db.Uuid
  brandId    String? @db.Uuid

  // Seller who created a new product entry
  createdBySellerId String? @db.Uuid

  // Product information
  name           String
  description    String
  approvalStatus ProductApprovalStatus @default(APPROVED)

  // Temporary fields (will move to SellerInventory later)
  price    Decimal @db.Decimal(12, 2)
  quantity Int     @default(0)
  imageUrl String?

  // Relations
  seller User @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)

  createdBySeller User? @relation("SellerCreatedProducts", fields: [createdBySellerId], references: [id], onDelete: SetNull)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images ProductImage[]

  inventory SellerInventory[]

  orderItems OrderItem[]

  reviews Review[]

  wishlistItems WishlistItem[] @relation("ProductWishlist")

  preferredRfqItems RfqItem[] @relation("PreferredRfqProduct")

  supplierQuoteItems SupplierQuoteItem[] @relation("QuotedProduct")

  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@index([price])
  @@index([quantity])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  imageUrl  String
  type      ProductImageType @default(DEFAULT)
  isPrimary Boolean          @default(false)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model SellerInventory {
  id String @id @default(uuid()) @db.Uuid

  sellerId  String @db.Uuid
  productId String @db.Uuid

  price    Decimal @db.Decimal(12, 2)
  quantity Int     @default(0)

  city              String
  region            String?
  deliveryAvailable Boolean @default(false)

  seller User @relation("SellerInventory", fields: [sellerId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, productId])
  @@index([productId])
  @@index([city])
  @@map("seller_inventory")
}

model Order {
  id               String         @id @default(uuid()) @db.Uuid
  customerId       String         @db.Uuid
  status           OrderStatus    @default(PENDING)
  paymentMethod    PaymentMethod  @default(CASH_ON_DELIVERY)
  totalAmount      Decimal        @db.Decimal(14, 2)
  shippingFullName String         @default("Not provided")
  shippingPhone    String         @default("Not provided")
  shippingCity     String         @default("Not provided")
  shippingAddress  String         @default("Not provided")
  shippingNotes    String?
  customer         User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  payment          Payment?
  sourceQuote      SupplierQuote?
  inventoryTransactions InventoryTransaction[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @db.Uuid
  method        PaymentMethod
  providerName  String
  proofImageUrl String
  status        PaymentStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime      @default(now())
  verifiedAt    DateTime?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payments")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @default(0) @db.Decimal(14, 2)

  // Legacy compatibility for seller dashboards and RFQ order creation.
  price   Decimal @db.Decimal(12, 2)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model InventoryTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  productId      String                   @db.Uuid
  orderId        String                   @db.Uuid
  type           InventoryTransactionType
  quantityChange Int
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())

  @@unique([orderId, productId, type])
  @@index([productId, createdAt])
  @@index([orderId])
  @@map("inventory_transactions")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  customerId String   @db.Uuid
  rating     Int
  comment    String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([productId, createdAt])
  @@index([customerId])
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  customer   User     @relation("CustomerWishlist", fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation("ProductWishlist", fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

model RequestForQuote {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @db.Uuid
  title            String
  deliveryLocation String
  notes            String?
  status           RfqStatus       @default(OPEN)
  expiresAt        DateTime
  awardedQuoteId   String?         @unique @db.Uuid
  customer         User            @relation("CustomerRfqs", fields: [customerId], references: [id], onDelete: Restrict)
  items            RfqItem[]
  quotes           SupplierQuote[] @relation("RfqQuotes")
  awardedQuote     SupplierQuote?  @relation("AwardedRfqQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("request_for_quotes")
}

model RfqItem {
  id                 String              @id @default(uuid()) @db.Uuid
  rfqId              String              @db.Uuid
  categoryId         String?             @db.Uuid
  preferredProductId String?             @db.Uuid
  categoryName       String
  materialName       String
  specifications     String?
  requestedQuantity  Decimal             @db.Decimal(14, 3)
  requestedUnit      RfqUnit
  customUnit         String?
  rfq                RequestForQuote     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  preferredProduct   Product?            @relation("PreferredRfqProduct", fields: [preferredProductId], references: [id], onDelete: SetNull)
  quoteItems         SupplierQuoteItem[]
  createdAt          DateTime            @default(now())

  @@index([rfqId])
  @@index([categoryId])
  @@index([preferredProductId])
  @@map("rfq_items")
}

model SupplierQuote {
  id           String              @id @default(uuid()) @db.Uuid
  rfqId        String              @db.Uuid
  sellerId     String              @db.Uuid
  status       SupplierQuoteStatus @default(SUBMITTED)
  validUntil   DateTime
  leadTimeDays Int
  terms        String?
  totalAmount  Decimal             @db.Decimal(14, 2)
  orderId      String?             @unique @db.Uuid
  rfq          RequestForQuote     @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  seller       User                @relation("SellerQuotes", fields: [sellerId], references: [id], onDelete: Restrict)
  items        SupplierQuoteItem[]
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  awardedFor   RequestForQuote?    @relation("AwardedRfqQuote")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([rfqId, sellerId])
  @@index([rfqId, status])
  @@index([sellerId, createdAt])
  @@index([sellerId, status])
  @@index([validUntil])
  @@map("supplier_quotes")
}

model SupplierQuoteItem {
  id              String        @id @default(uuid()) @db.Uuid
  quoteId         String        @db.Uuid
  rfqItemId       String        @db.Uuid
  productId       String?       @db.Uuid
  productName     String
  offeredQuantity Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)
  quote           SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem         RfqItem       @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)
  product         Product?      @relation("QuotedProduct", fields: [productId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@unique([quoteId, rfqItemId])
  @@unique([quoteId, productId])
  @@index([rfqItemId])
  @@index([productId])
  @@map("supplier_quote_items")
}
