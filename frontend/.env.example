# Backend API base URL (including the /api path prefix).
# The value below is for LOCAL DEVELOPMENT only.
# For a production build, replace this with the real production API URL
# (e.g. https://api.your-domain.com/api) BEFORE running `npm run build`.
# Vite bakes this value into the bundle at build time — it is NOT read at runtime.
VITE_API_BASE_URL=http://localhost:3055/api
VITE_API_TIMEOUT_MS=60000
